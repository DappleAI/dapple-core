# Docker doesn't read .gitignore — it only consults .dockerignore. Without
# this file, the entire workspace (including target/, .git, node_modules,
# OS metadata, etc.) gets shipped to the build daemon. We were seeing
# 29.83 GB build contexts and stale dapple-data*.rlib artifacts from the
# host's target/ getting linked instead of fresh compilations — silently
# producing binaries that didn't reflect committed source changes.

# Cargo build artifacts (host builds — must not pollute container target/)
**/target
**/debug

# IDE / editor state
.idea/
.vscode/
*.swp
*.swo
*~
*.rs.bk

# OS metadata
.DS_Store
**/.DS_Store

# Git data (the worktree's .git is a small file but git history is irrelevant
# to the build; explicitly exclude to avoid surprises if Docker resolves it)
.git
**/.git

# mdbook output
**/docs/**/book/

# Worktree machinery — avoids recursive copy of nested worktrees
.claude/worktrees

# Generated by cargo mutants
**/mutants.out*

# Compiled Windows debug info (defensive — shouldn't appear on macOS/Linux)
*.pdb

# SQLx offline cache is needed (the Dockerfile sets SQLX_OFFLINE=true) so
# we DO ship .sqlx/ — do not exclude it.
