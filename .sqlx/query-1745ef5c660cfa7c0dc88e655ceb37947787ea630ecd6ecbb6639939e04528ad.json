{
  "db_name": "PostgreSQL",
  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],\n        $2::INTEGER[]\n    ) WITH ORDINALITY AS o(asset_id, extractor_version, ord)\n),\nobjs AS (\n    INSERT INTO rev.asset_dataset_extractions (asset_id, extractor_version, status)\n    SELECT args.asset_id, args.extractor_version, 'pending'\n    FROM args\n    ORDER BY args.ord\n    RETURNING\n        id,\n        asset_id,\n        extractor_version,\n        status,\n        envelope,\n        table_count,\n        row_count,\n        error_message,\n        created_at,\n        completed_at\n)\nSELECT\n    id,\n    asset_id,\n    extractor_version,\n    status,\n    envelope,\n    table_count,\n    row_count,\n    error_message,\n    created_at,\n    completed_at\nFROM objs\nORDER BY id;\n",
