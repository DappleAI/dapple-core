{
  "db_name": "PostgreSQL",
  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],               $2::SMALLINT[]        ) WITH ORDINALITY AS o(embedding_id, locale_id, ord)\n),\nnew_locales AS (\n    INSERT INTO rev.guide_embedding_locales (id, embedding_id, locale_id)\n    SELECT uuidv7(), args.embedding_id, args.locale_id\n    FROM args\n    ORDER BY args.ord\n    ON CONFLICT (embedding_id, locale_id) DO NOTHING\n    RETURNING id, embedding_id, locale_id, created_at\n)\nSELECT\n    nl.id,\n    nl.embedding_id,\n    nl.locale_id,\n    nl.created_at\nFROM new_locales nl\nORDER BY nl.id;\n",
