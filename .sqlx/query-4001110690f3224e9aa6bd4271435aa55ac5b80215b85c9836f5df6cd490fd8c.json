  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(id, ord)\n)\nSELECT\n    d.id,\n    d.asset_kind_id,\n    ak.key as asset_kind_key,\n    d.mime_type,\n    d.created_at\nFROM args\nJOIN rev.drafts d ON d.id = args.id\nJOIN rev.asset_kinds ak ON ak.id = d.asset_kind_id\nORDER BY d.id;\n",
