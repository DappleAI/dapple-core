  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(id, ord)\n)\nSELECT\n    op.id,\n    fmpd.name,\n    fmpd.description,\n    op.created_at\nFROM args\nJOIN rev.object_paths op ON op.id = args.id\nJOIN rev.fluent_message_path_details fmpd ON fmpd.path_id = op.id\nORDER BY op.id;\n",
