{
  "db_name": "PostgreSQL",
  "query": "WITH value_slot_latest AS (\n    SELECT DISTINCT ON (op.id)\n        vs.id\n    FROM rev.value_slots vs\n    JOIN rev.versioned_objects vo ON vo.id = vs.versioned_object_id\n    JOIN rev.object_paths op ON op.id = vo.path_id\n    LEFT JOIN LATERAL (\n        SELECT de.to_level_id\nFROM rev.deprecation_events de\nWHERE de.versioned_object_id = vo.id\nORDER BY de.created_at DESC\nLIMIT 1\n\n    ) ld ON TRUE\n    LEFT JOIN rev.deprecation_levels dl ON dl.id = ld.to_level_id\n    WHERE dl.id IS NULL\n      AND op.namespace_company_id = $1::UUID\n    ORDER BY op.id, vo.created_at DESC\n),\nvalue_slot_page AS (\n    SELECT id FROM value_slot_latest\n    ORDER BY id\n    LIMIT $2::BIGINT OFFSET $3::BIGINT\n)\n\nSELECT\n    vs.id,\n    vs.versioned_object_id,\n    op.id AS path_id,\n    vspd.name,\n    vk.key as value_kind_key,\n    vo.content_hash,\n    dl.key AS \"deprecation_level_key?\",\n    vs.title,\n    vs.description,\n    vs.constraints,\n    vs.cardinality,\n    vs.min_selections,\n    vs.max_selections,\n    vs.created_at\nFROM value_slot_page vskp\nJOIN rev.value_slots vs ON vs.id = vskp.id\nJOIN rev.versioned_objects vo ON vo.id = vs.versioned_object_id\nJOIN rev.object_paths op ON op.id = vo.path_id\nJOIN rev.value_slot_path_details vspd ON vspd.path_id = op.id\nJOIN rev.value_kinds vk ON vk.id = vs.value_kind_id\nLEFT JOIN LATERAL (\n    SELECT de.to_level_id\nFROM rev.deprecation_events de\nWHERE de.versioned_object_id = vo.id\nORDER BY de.created_at DESC\nLIMIT 1\n\n) ld ON TRUE\nLEFT JOIN rev.deprecation_levels dl ON dl.id = ld.to_level_id\nORDER BY vs.id;\n\n",
