  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(guide_id, ord)\n)\nSELECT\n    gc.id,\n    gc.guide_id,\n    gc.subtitle,\n    gc.card_image_asset_id,\n    gc.category,\n    gc.color,\n    gc.accent,\n    gc.created_at\nFROM args\nJOIN rev.guide_cards gc ON gc.guide_id = args.guide_id\nORDER BY gc.guide_id, gc.id;\n",
