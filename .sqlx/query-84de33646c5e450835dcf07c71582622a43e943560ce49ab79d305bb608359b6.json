  "db_name": "PostgreSQL",
  "query": "SELECT\n    vo.id AS versioned_object_id,\n    g.id AS guide_id,\n    vo.content_hash\nFROM rev.versioned_objects vo\nJOIN rev.object_paths op ON op.id = vo.path_id\nJOIN rev.guides g ON g.versioned_object_id = vo.id\nWHERE op.id = $1\n  AND vo.content_hash = $2\nLIMIT 1;\n",
