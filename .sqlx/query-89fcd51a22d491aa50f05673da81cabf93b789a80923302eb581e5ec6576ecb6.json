  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(id, ord)\n)\nSELECT\n    op.id,\n    op.entity_type_id,\n    et.key AS entity_type_key,\n    op.created_at\nFROM args\nJOIN rev.object_paths op ON op.id = args.id\nJOIN rev.entity_types et ON et.id = op.entity_type_id\nORDER BY op.id;\n",
