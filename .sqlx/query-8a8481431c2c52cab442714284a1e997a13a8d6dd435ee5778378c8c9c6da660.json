{
  "db_name": "PostgreSQL",
  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::TEXT[],\n        $2::UUID[],\n        $3::JSONB[]\n    ) WITH ORDINALITY AS o(job_kind, target_id, payload, ord)\n),\nobjs AS (\n    INSERT INTO rev.background_jobs (job_kind, target_id, payload)\n    SELECT args.job_kind, args.target_id, args.payload\n    FROM args\n    ORDER BY args.ord\n    RETURNING\n        id,\n        job_kind,\n        target_id,\n        payload,\n        status,\n        attempts,\n        max_attempts,\n        error_message,\n        scheduled_at,\n        claimed_at,\n        completed_at,\n        created_at\n)\nSELECT\n    id,\n    job_kind,\n    target_id,\n    payload,\n    status,\n    attempts,\n    max_attempts,\n    error_message,\n    scheduled_at,\n    claimed_at,\n    completed_at,\n    created_at\nFROM objs\nORDER BY id;\n",
