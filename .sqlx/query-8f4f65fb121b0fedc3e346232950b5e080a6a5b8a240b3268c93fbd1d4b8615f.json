{
  "db_name": "PostgreSQL",
  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],               $2::SMALLINT[]        ) WITH ORDINALITY AS o(embedding_id, tag_id, ord)\n),\nnew_tags AS (\n    INSERT INTO rev.guide_embedding_tags (id, embedding_id, tag_id)\n    SELECT uuidv7(), args.embedding_id, args.tag_id\n    FROM args\n    ORDER BY args.ord\n    ON CONFLICT (embedding_id, tag_id) DO NOTHING\n    RETURNING id, embedding_id, tag_id, created_at\n)\nSELECT\n    nt.id,\n    nt.embedding_id,\n    nt.tag_id,\n    nt.created_at\nFROM new_tags nt\nORDER BY nt.id;\n",
