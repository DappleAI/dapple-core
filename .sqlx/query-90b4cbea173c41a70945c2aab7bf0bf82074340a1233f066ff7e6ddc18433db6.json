  "query": "SELECT\n    st.id,\n    st.service_id,\n    st.public_key_pem,\n    st.key_algorithm,\n        (\n        SELECT MIN(r.revoked_at)\n        FROM web.service_token_revocations r\n        WHERE r.service_token_id = st.id\n    ) AS revoked_at\nFROM web.service_tokens st\nWHERE st.service_id = $1;\n",
