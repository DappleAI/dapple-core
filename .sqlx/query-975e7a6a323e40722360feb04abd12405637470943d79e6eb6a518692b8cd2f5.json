  "query": "SELECT\n    les.id,\n    les.resource_type_id,\n    les.resource_id,\n    les.lago_transaction_id,\n    les.retry_count,\n    les.created_at\nFROM rev.lago_event_sync les\nWHERE les.sent_at IS NULL\n  AND (les.next_retry_at IS NULL OR les.next_retry_at <= now())\nORDER BY les.created_at\nLIMIT $1::BIGINT;\n",
