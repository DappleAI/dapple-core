  "query": "INSERT INTO rev.dispatch_task_attempts (dispatch_step_id, task_id, context_data, context_metadata)\nVALUES (\n  (SELECT id FROM rev.dispatch_steps WHERE id = $1::uuid),\n  (SELECT id FROM rev.tasks WHERE id = $2::uuid),\n  $3::jsonb,\n  $4::jsonb\n)\nRETURNING\n  id,\n  dispatch_step_id,\n  task_id,\n  context_data,\n  context_metadata,\n  created_at;\n",
