  "query": "\nWITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(id, ord)\n)\nSELECT\n    op.id,\n    ppd.name,\n    op.created_at\nFROM args\nJOIN rev.object_paths op ON op.id = args.id\nJOIN rev.prompt_path_details ppd ON ppd.path_id = op.id\nORDER BY op.id;\n",
