{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    c.id,\n    cc.checksum as stored_checksum,\n    sha256(c.data) as computed_checksum,\n    octet_length(c.data) as byte_length,\n    c.created_at\nFROM rev.chunks c\nJOIN rev.chunk_checksums cc ON cc.chunk_id = c.id\nWHERE cc.checksum != sha256(c.data)\nORDER BY c.id;\n",
