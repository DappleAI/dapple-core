{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    a.id,\n    a.dispatch_step_id,\n    a.task_id,\n    COALESCE(\n        (\n            SELECT ev.phase_code\n            FROM rev.dispatch_task_attempt_events ev\n            WHERE ev.attempt_id = a.id\n            ORDER BY ev.created_at DESC, ev.id DESC\n            LIMIT 1\n        ),\n        'queued'\n    ) AS \"status!\",\n    a.context_data,\n    a.context_metadata,\n    NULL::text AS error_detail,\n    a.created_at\nFROM rev.dispatch_task_attempts a\nWHERE a.id = $1::uuid;\n",
