  "query": "\nWITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],\n        $2::BIGINT[]\n    ) WITH ORDINALITY AS o(binding_id, value, ord)\n)\nINSERT INTO rev.dispatch_intent_binding_int_items (dispatch_intent_binding_id, value)\nSELECT args.binding_id, args.value\nFROM args\nORDER BY args.ord\nRETURNING id, dispatch_intent_binding_id, value, created_at;\n",
