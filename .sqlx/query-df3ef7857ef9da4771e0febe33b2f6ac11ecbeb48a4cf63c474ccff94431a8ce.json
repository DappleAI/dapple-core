  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],              $2::SMALLINT[]       ) WITH ORDINALITY AS o(\n        block_id,\n        tag_id,\n        ord\n    )\n)\nINSERT INTO rev.guide_block_tags (id, block_id, tag_id)\nSELECT uuidv7(), args.block_id, args.tag_id\nFROM args\nORDER BY args.ord\nRETURNING id, block_id, tag_id, created_at;\n",
