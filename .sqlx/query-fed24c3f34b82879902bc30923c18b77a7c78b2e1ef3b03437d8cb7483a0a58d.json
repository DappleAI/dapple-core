  "query": "WITH token_lookup AS (\n    SELECT id\n    FROM rev.external_service_tokens\n    WHERE id = $1::UUID\n)\nINSERT INTO rev.external_service_token_revocations (\n    external_service_token_id,\n    reason\n)\nSELECT\n    token_lookup.id,\n    $2::TEXT\nFROM token_lookup\nRETURNING\n    id,\n    external_service_token_id,\n    revoked_at,\n    revoked_by_user_id,\n    reason;\n",
