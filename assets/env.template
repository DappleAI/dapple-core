# Authentication Configuration
# Copy this file to .env and fill in values

# =============================================================================
# PROMPT-API SECRETS (backend services)
# =============================================================================

# REQUIRED: Secret for signing/validating JWTs issued by prompt-api
# AUTO-GENERATED by deploy_dapple_prompt_pods.nu if not set
# Generate manually with: openssl rand -hex 32
DAPPLE_PROMPT_API_SIGNING_KEY={{DAPPLE_PROMPT_API_SIGNING_KEY}}

# REQUIRED: Secret for signing/validating JWTs issued by the customer-facing
# external API surface. MUST be a different value from
# DAPPLE_PROMPT_API_SIGNING_KEY — the two surfaces are cryptographically
# isolated, so a shared key collapses that isolation guarantee.
# AUTO-GENERATED by deploy_dapple_prompt_pods.nu if not set
# Generate manually with: openssl rand -hex 32
DAPPLE_PROMPT_EXTERNAL_API_SIGNING_KEY={{DAPPLE_PROMPT_EXTERNAL_API_SIGNING_KEY}}

# AUTO-DERIVED: Comma-separated Ethereum addresses allowed to exchange signed messages for JWTs
# If DAPPLE_UI_ETH_PRIVATE_KEY is set, its address is automatically added by the deploy script
# You only need to set this manually for additional external services
# AUTH_TOKEN_ALLOWED_SIGNERS=0x...

# Optional: JWT expiration in seconds (default: 3600 = 1 hour)
# AUTH_TOKEN_JWT_EXPIRY_SECS=3600

# =============================================================================
# DAPPLE-UI SECRETS (Next.js web application)
# =============================================================================

# REQUIRED: NextAuth.js secret for session encryption
# AUTO-GENERATED by deploy_dapple_web_pods.nu if not set
# Generate manually with: openssl rand -base64 32
NEXTAUTH_SECRET={{NEXTAUTH_SECRET}}

# REQUIRED: Canonical URL of the web application
NEXTAUTH_URL={{NEXTAUTH_URL}}

# =============================================================================
# SERVICE AUTHORIZATION TOKEN (SAT) AUTHENTICATION (Ed25519)
# Used by internal services (dapple-ui, dapple-landing) to authenticate with prompt-api
#
# SAT = Service Authorization Token
# These Ed25519 private keys are used to sign short-lived tokens that are
# exchanged for JWTs via /api/get-service-token
# =============================================================================

# REQUIRED: URL of the prompt-api service (internal k8s URL)
DAPPLE_PROMPT_API_INTERNAL_URL={{DAPPLE_PROMPT_API_INTERNAL_URL}}

# Service-specific Ed25519 private keys (64 hex chars)
# These are AUTO-GENERATED by deploy_dapple_prompt_pods.nu if not set.
# The corresponding public keys are automatically registered in web.service_tokens.
#
# To manually generate:
#   nu assets/nu/tools/service_token.nu generate dapple_ui
#
DAPPLE_UI_SAT_SIGNING_KEY={{DAPPLE_UI_SAT_SIGNING_KEY}}
DAPPLE_LANDING_SAT_SIGNING_KEY={{DAPPLE_LANDING_SAT_SIGNING_KEY}}

# OAuth Providers (for NextAuth.js)
OAUTH_GOOGLE_CLIENT_ID={{OAUTH_GOOGLE_CLIENT_ID}}
OAUTH_GOOGLE_CLIENT_SECRET={{OAUTH_GOOGLE_CLIENT_SECRET}}

# =============================================================================
# LEGACY: Ethereum-Signed Tokens (for external services with wallet infrastructure)
# =============================================================================

# Optional: Ethereum private key for signing auth tokens (external services only)
# AUTO-GENERATED by deploy_dapple_prompt_pods.nu if not set
# Generate manually with: cast wallet new (or any Ethereum wallet)
# The deploy scripts automatically derive the address and add it to AUTH_TOKEN_ALLOWED_SIGNERS
DAPPLE_UI_ETH_PRIVATE_KEY={{DAPPLE_UI_ETH_PRIVATE_KEY}}

# =============================================================================
# FLAGSMITH FEATURE FLAG PLATFORM SECRETS
# =============================================================================

# Django secret key (64 hex chars)
# AUTO-GENERATED by setup_flagsmith.nu / env_dapple.nu if not set
# Generate manually with: openssl rand -hex 32
FLAGSMITH_DJANGO_SECRET_KEY={{FLAGSMITH_DJANGO_SECRET_KEY}}

# =============================================================================
# LLM API KEYS (for dapple-prompt-conduit)
# =============================================================================

# Anthropic API key for Claude models
# Get from: https://console.anthropic.com/settings/keys
# NOT auto-generated — each engineer provides their own key in ~/.env
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# HuggingFace token for downloading gated models (Mistral, etc.)
# Get from: https://huggingface.co/settings/tokens
# Required for local LLM inference; NOT auto-generated
HF_TOKEN={{HF_TOKEN}}

# mistral.rs local LLM backend (replaces Candle for text generation)
# Uses pre-quantized GGUF weights for instant loading (~4GB, no ISQ delay)
# GGUF repo: https://huggingface.co/bartowski/Mistral-7B-Instruct-v0.3-GGUF
# MISTRALRS_MODEL_ID=bartowski/Mistral-7B-Instruct-v0.3-GGUF
# MISTRALRS_GGUF_FILE=Mistral-7B-Instruct-v0.3-Q4_K_M.gguf
# MISTRALRS_TOK_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

