#!/usr/bin/env nu
# Managed environment file generator
#
# Generates a complete ~/.dapple/generated.env from assets/env.template.
# Value resolution priority: ~/.dapple/env (hand-authored) > existing
# generated.env > auto-generate > empty

use std/log
use ../dapple_env_profiles/env_files.nu *

# Generate a complete ~/.dapple/generated.env from assets/env.template
# Values from ~/.dapple/env take precedence, making the generated file
# self-contained for deployment. Secrets are auto-generated if set in neither.
# Template uses {{VAR}} placeholders that get substituted with values
export def gen [
    --example-file: path  # Path to env.template (default: $DAPPLE_PROMPT_WORKSPACE_DIR/assets/env.template)
] {
    let home = if "home-dir" in ($nu | columns) { $nu.home-dir } else { $nu.home-path }
    # Paths come from env_files.nu so this generator and the shell profile can
    # never disagree about where configuration lives — two consumers looking at
    # different paths is what produced the ~/.env / ~/.env.prod duplication.
    let user_env_file = (user_env_path $home)
    let dapple_env_file = (generated_env_path $home)

    # REFUSE on an unmigrated host, rather than silently minting new secrets.
    #
    # Resolution order below is user_vars -> existing -> auto-generate. On a host
    # that still has the pre-move layout, BOTH inputs are absent — the values are
    # sitting in ~/.env.dapple, which nothing reads any more — so every secret
    # falls through to auto-generate. That rotates DAPPLE_PROMPT_API_SIGNING_KEY
    # and friends, and the callers push them straight into k8s secrets,
    # invalidating every issued service token and JWT. Nothing errors; the deploy
    # just quietly re-keys the cluster.
    #
    # The guard lives HERE rather than in each caller because there are several
    # entry points [setup_nu.nu, setup_auth_secret, setup_external_auth_secret,
    # the flagsmith secret setup] and one of them is enough to do it.
    # setup.nu is unaffected: it runs migrate_legacy_files first, which always
    # creates this file.
    if not ($user_env_file | path exists) {
        error make { msg: $"($user_env_file) does not exist — refusing to generate secrets.

This host has not been migrated to the ~/.dapple/ layout. Generating now would
auto-create fresh values for every secret, including the API signing keys, and
whatever called this would push them into the cluster — invalidating every
service token and JWT already issued.

Migrate first [it is idempotent, and carries ~/.env + ~/.env.dapple across]:

    nu assets/nu/init/setup.nu --environment sandbox

Then re-run this." }
    }

    let example_file = if ($example_file | is-empty) {
        $env.DAPPLE_PROMPT_WORKSPACE_DIR | path join "assets" | path join "env.template"
    } else {
        $example_file
    }

    if not ($example_file | path exists) {
        log error $"Example file not found: ($example_file)"
        return
    }

    # Load the hand-authored file as a key-value record (it takes precedence)
    let user_vars = if ($user_env_file | path exists) {
        open --raw $user_env_file | lines
        | where {|l| $l !~ '^#' and $l != '' and ($l | str contains '=')}
        | each {|l|
            let parts = ($l | split row '=' -n 2)
            let key = ($parts | first | str trim)
            let value = ($parts | get 1? | default "" | str trim)
            {key: $key, value: $value}
        }
        | reduce -f {} {|it, acc| $acc | merge {($it.key): $it.value}}
    } else {
        {}
    }

    log info $"Generating ($dapple_env_file) from ($example_file)"
    log info $"User overrides in ($user_env_file): ($user_vars | columns | length) variables"

    # Load the existing generated file to preserve secrets across regenerations
    let existing_secrets = load_existing_secrets $dapple_env_file

    # Process env.template
    let example_lines = open $example_file --raw | lines

    let output_lines = $example_lines | each {|line|
        if ($line | str starts-with '#') or ($line == '') {
            # Keep comments and blank lines
            $line
        } else if ($line | str contains '=') {
            let key = ($line | split row '=' -n 2 | first | str trim)
            # Process ALL vars - user_vars checked inside process_template_line
            process_template_line $key $line $user_vars $existing_secrets
        } else {
            $line
        }
    }

    # Add header
    let header = [
        "# AUTO-GENERATED FILE - DO NOT EDIT"
        "# Generated by: env_dapple.nu generate"
        $"# Generated at: (date now | format date '%Y-%m-%d %H:%M:%S')"
        "#"
        $"# User overrides go in ($user_env_file)"
        "# Regenerate with: use env_dapple.nu; env_dapple gen"
        ""
    ]

    # Write to the generated-secrets file
    ($header ++ $output_lines) | str join "\n" | save -f $dapple_env_file
    log info $"Generated ($dapple_env_file)"

    # Validate required variables have values
    let required_vars = [
        "OAUTH_GOOGLE_CLIENT_ID"
        "OAUTH_GOOGLE_CLIENT_SECRET"
    ]

    let generated_vars = $output_lines
        | where {|l| ($l | str contains '=') and not ($l | str starts-with '#')}
        | each {|l|
            let parts = ($l | split row '=' -n 2)
            let key = ($parts | first | str trim)
            let value = ($parts | get 1? | default "" | str trim)
            {key: $key, value: $value}
        }
        | reduce -f {} {|it, acc| $acc | merge {($it.key): $it.value}}

    let missing = $required_vars | where {|var|
        not ($var in $generated_vars) or (($generated_vars | get $var) == "")
    }

    if ($missing | is-not-empty) {
        log warning $"Missing required variables: ($missing | str join ', ')"
        log warning $"Add these to ($user_env_file) and regenerate"
    }
}

# Load existing generated values to preserve them across regenerations
# Preserves ALL existing non-empty values (other scripts may append to this file)
def load_existing_secrets [file: path]: nothing -> record {
    if not ($file | path exists) {
        return {}
    }

    open --raw $file | lines
    | where {|l| $l !~ '^#' and $l != '' and ($l | str contains '=')}
    | each {|l|
        let parts = ($l | split row '=' -n 2)
        let key = ($parts | first | str trim)
        let value = ($parts | get 1? | default "" | str trim)
        if ($value | is-not-empty) {
            {key: $key, value: $value}
        } else {
            null
        }
    }
    | compact
    | reduce -f {} {|it, acc| $acc | merge {($it.key): $it.value}}
}

# Process a template line with {{VAR}} placeholder
# Generates or looks up value, substitutes placeholder
# Priority: user_vars (~/.dapple/env) > existing (generated.env) > auto-generate > empty
def process_template_line [key: string, original_line: string, user_vars: record, existing: record]: nothing -> string {
    # Priority 1: User override from ~/.dapple/env
    if ($key in $user_vars) {
        let value = ($user_vars | get $key)
        return $"($key)=($value)"
    }

    # Priority 2: Existing generated value from ~/.env.dapple
    if ($key in $existing) {
        let value = ($existing | get $key)
        return $"($key)=($value)"
    }

    # Priority 3: Auto-generate for known secrets
    match $key {
        "DAPPLE_PROMPT_API_SIGNING_KEY" => {
            let value = (openssl rand -hex 32 | str trim)
            $"DAPPLE_PROMPT_API_SIGNING_KEY=($value)"
        }
        "DAPPLE_PROMPT_EXTERNAL_API_SIGNING_KEY" => {
            # Distinct from DAPPLE_PROMPT_API_SIGNING_KEY — see env.template
            # for why the two surfaces must not share a signing key.
            let value = (openssl rand -hex 32 | str trim)
            $"DAPPLE_PROMPT_EXTERNAL_API_SIGNING_KEY=($value)"
        }
        "DAPPLE_UI_SAT_SIGNING_KEY" => {
            let value = (openssl rand -hex 32 | str trim)
            $"DAPPLE_UI_SAT_SIGNING_KEY=($value)"
        }
        "DAPPLE_LANDING_SAT_SIGNING_KEY" => {
            let value = (openssl rand -hex 32 | str trim)
            $"DAPPLE_LANDING_SAT_SIGNING_KEY=($value)"
        }
        "DAPPLE_UI_ETH_PRIVATE_KEY" => {
            # Check if cast is available
            let cast_check = (which cast | length) > 0
            if $cast_check {
                let result = (do { ^cast wallet new --json } | complete)
                if $result.exit_code == 0 {
                    let wallet = ($result.stdout | from json)
                    $"DAPPLE_UI_ETH_PRIVATE_KEY=($wallet.private_key)"
                } else {
                    log warning "cast wallet generation failed"
                    # Return key with empty value (placeholder stripped)
                    $"($key)="
                }
            } else {
                log warning "cast not available - skipping DAPPLE_UI_ETH_PRIVATE_KEY generation"
                # Return key with empty value (placeholder stripped)
                $"($key)="
            }
        }
        "NEXTAUTH_SECRET" => {
            let value = (openssl rand -base64 32 | str trim)
            $"NEXTAUTH_SECRET=($value)"
        }
        "FLAGSMITH_DJANGO_SECRET_KEY" => {
            let value = (openssl rand -hex 32 | str trim)
            $"FLAGSMITH_DJANGO_SECRET_KEY=($value)"
        }
        _ => {
            # For non-generated keys, strip the {{VAR}} placeholder and leave empty
            # or preserve any default value after the placeholder
            let value_part = ($original_line | split row '=' -n 2 | get 1? | default "")
            # Check if it's a {{VAR}} placeholder
            if ($value_part | str contains '{{') {
                # Strip placeholder, leave empty
                $"($key)="
            } else {
                # Keep original line as-is
                $original_line
            }
        }
    }
}

# Main entry point when run as script
def main [
    command?: string  # Command to run (gen)
    --example-file: path  # Path to env.template
] {
    if ($command | is-empty) or $command == "gen" {
        gen --example-file $example_file
    } else {
        print "Usage: env_dapple.nu gen [--example-file <path>]"
    }
}
