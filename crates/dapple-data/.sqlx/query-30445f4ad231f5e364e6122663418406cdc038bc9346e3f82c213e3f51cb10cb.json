{
  "db_name": "PostgreSQL",
  "query": "UPDATE rev.background_jobs\nSET status = 'running',\n    claimed_at = now(),\n    attempts = attempts + 1\nWHERE id = (\n    SELECT id\n    FROM rev.background_jobs\n    WHERE status = 'queued'\n      AND scheduled_at <= now()\n      AND (\n          job_kind = ANY($1::TEXT[])\n          OR $1::TEXT[] IS NULL\n          OR array_length($1::TEXT[], 1) IS NULL\n      )\n    ORDER BY scheduled_at\n    FOR UPDATE SKIP LOCKED\n    LIMIT 1\n)\nRETURNING\n    id,\n    job_kind,\n    target_id,\n    payload,\n    status,\n    attempts,\n    max_attempts,\n    error_message,\n    scheduled_at,\n    claimed_at,\n    completed_at,\n    created_at;\n",
