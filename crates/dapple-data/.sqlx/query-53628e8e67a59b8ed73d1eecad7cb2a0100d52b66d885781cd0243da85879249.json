  "query": "WITH token_lookup AS (\n    SELECT id\n    FROM web.api_tokens\n    WHERE id = $1\n),\nobjs AS (\n    INSERT INTO web.api_token_revocations (api_token_id, reason)\n    SELECT\n        token_lookup.id,\n        $2::TEXT\n    FROM token_lookup\n    RETURNING *\n)\nSELECT\n    objs.id,\n    objs.api_token_id,\n    objs.reason,\n    objs.revoked_at\nFROM objs;\n",
