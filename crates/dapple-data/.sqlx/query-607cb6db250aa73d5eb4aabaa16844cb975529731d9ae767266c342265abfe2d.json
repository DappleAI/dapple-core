{
  "db_name": "PostgreSQL",
  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],\n        $2::TEXT[],\n        $3::INTEGER[]\n    ) WITH ORDINALITY AS o(asset_id, extractor_kind, extractor_version, ord)\n),\nobjs AS (\n    INSERT INTO rev.asset_extractions (\n        asset_id, extractor_kind, extractor_version, status, is_current\n    )\n    SELECT\n        args.asset_id,\n        args.extractor_kind,\n        args.extractor_version,\n        'pending',\n        TRUE\n    FROM args\n    ORDER BY args.ord\n    RETURNING\n        id,\n        asset_id,\n        extractor_kind,\n        extractor_version,\n        status,\n        text_length,\n        page_count,\n        metadata,\n        error_message,\n        is_current,\n        created_at,\n        completed_at\n)\nSELECT\n    id,\n    asset_id,\n    extractor_kind,\n    extractor_version,\n    status,\n    text_length,\n    page_count,\n    metadata,\n    error_message,\n    is_current,\n    created_at,\n    completed_at\nFROM objs\nORDER BY id;\n",
