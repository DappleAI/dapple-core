  "query": "WITH args AS (\n    SELECT *\n    FROM UNNEST($1::UUID[], $2::TEXT[])\n    WITH ORDINALITY AS o(media_item_id, url, ord)\n)\nINSERT INTO rev.brief_unit_media_item_url_sources (media_item_id, url)\nSELECT args.media_item_id, args.url\nFROM args\nORDER BY args.ord\nRETURNING media_item_id, url;\n",
