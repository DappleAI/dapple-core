  "query": "SELECT\n    dc.id,\n    dc.draft_id,\n    dc.chunk_id,\n    c.data,\n    dc.ordinal,\n    dc.created_at\nFROM rev.draft_chunks dc\nJOIN rev.drafts d ON d.id = dc.draft_id\nJOIN rev.chunks c ON c.id = dc.chunk_id\nWHERE d.id = $1\nORDER BY dc.ordinal;\n",
