{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    pr.id,\n    pr.attempt_id,\n    pr.prompt_id,\n    pr.step_task_id,\n    pr.maker_key,\n    pr.engine_key,\n    pr.engine_version,\n    pr.request_messages,\n    pr.response_content,\n    pr.input_tokens,\n    pr.output_tokens,\n    pr.latency_ms,\n    pr.finish_reason,\n    pr.started_at,\n    pr.completed_at\nFROM rev.prompt_responses pr\nWHERE pr.attempt_id IN (\n    SELECT a.id\n    FROM rev.dispatch_task_attempts a\n    WHERE a.dispatch_step_id IN (\n        SELECT s.id\n        FROM rev.dispatch_steps s\n        JOIN rev.dispatch_stages st ON s.dispatch_stage_id = st.id\n        JOIN rev.dispatches d ON st.dispatch_id = d.id\n        WHERE d.id = $1::UUID\n    )\n)\nORDER BY pr.started_at ASC, pr.id ASC;\n",
