{
  "db_name": "PostgreSQL",
  "query": "\nWITH args AS (\n    SELECT *\n    FROM UNNEST(\n        $1::UUID[],\n        $2::TEXT[],\n        $3::JSONB[],\n        $4::JSONB[],\n        $5::JSONB[]\n    ) WITH ORDINALITY AS o(brief_id, unit_key, layout, requires, extensions, ord)\n),\nobjs AS (\n    INSERT INTO rev.brief_units (\n        brief_id,\n        unit_key,\n        layout,\n        requires,\n        extensions,\n        created_at\n    )\n    SELECT\n        args.brief_id,\n        args.unit_key,\n        COALESCE(args.layout, '{}'::jsonb),\n        COALESCE(args.requires, '{}'::jsonb),\n        COALESCE(args.extensions, '{}'::jsonb),\n        now()\n    FROM args\n    ORDER BY args.ord\n    RETURNING id, brief_id, unit_key, layout, requires, extensions, created_at\n)\nSELECT\n    objs.id,\n    objs.brief_id,\n    objs.unit_key,\n    objs.layout,\n    objs.requires,\n    objs.extensions,\n    objs.created_at\nFROM objs\nORDER BY objs.id;\n",
