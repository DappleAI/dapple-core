{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    t.id,\n    ud.object_id AS user_id,\n    t.name,\n    t.token_hash,\n    t.token_prefix,\n    t.expires_at,\n    t.created_at,\n        (\n        SELECT MIN(r.revoked_at)\n        FROM web.api_token_revocations r\n        WHERE r.api_token_id = t.id\n    ) AS revoked_at\nFROM web.api_tokens t\nJOIN rev.user_details ud ON ud.user_id = t.user_id\nWHERE t.id = $1;\n",
