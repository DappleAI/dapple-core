# Similarity search over asset content embeddings, optionally scoped to
# specific assets. Loaded via include_str!() from sqlx::query_as because
# query_file_as! cannot handle vector(768) parameters at compile time.
#
# When $2 is an empty array, the filter is a no-op and the search runs
# across all assets.
#
# Parameters:
#   $1: query_embedding (vector(768))
#   $2: asset_ids (UUID[]) — empty array means "all assets"
#   $3: limit (INTEGER)
SELECT
    e.id,
    e.asset_id,
    e.extraction_id,
    e.chunk_index,
    e.chunk_text,
    e.source_position,
    e.metadata,
    (1 - (e.embedding <=> $1::vector(768)))::FLOAT8 AS similarity
FROM rev.asset_content_embeddings e
WHERE (
    COALESCE(array_length($2::UUID[], 1), 0) = 0
    OR e.asset_id = ANY($2::UUID[])
)
ORDER BY e.embedding <=> $1::vector(768)
LIMIT $3;
