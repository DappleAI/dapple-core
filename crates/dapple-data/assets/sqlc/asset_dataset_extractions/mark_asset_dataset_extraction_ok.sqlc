# Transition a dataset extraction to 'ok' and write the schema envelope + counts.
# This is the ONE point the write-once envelope/content columns are set (they
# default to '{}' at the pending insert and are never mutated after this).
# Parameters:
#   $1: id (UUID)
#   $2: envelope (JSONB)
#   $3: table_count (INTEGER)
#   $4: row_count (BIGINT)
UPDATE rev.asset_dataset_extractions
SET status = 'ok',
    envelope = $2,
    table_count = $3,
    row_count = $4,
    completed_at = now()
WHERE id = $1
RETURNING
    id,
    asset_id,
    extractor_version,
    status,
    envelope,
    table_count,
    row_count,
    error_message,
    created_at,
    completed_at;
