# Transition a dataset extraction from 'pending' to 'running'. Returns the
# updated row; returns no rows if the extraction was not in 'pending' state.
# Lifecycle status only — the envelope stays write-once (set at the ok transition).
# Parameters:
#   $1: id (UUID)
UPDATE rev.asset_dataset_extractions
SET status = 'running'
WHERE id = $1
  AND status = 'pending'
RETURNING
    id,
    asset_id,
    extractor_version,
    status,
    envelope,
    table_count,
    row_count,
    error_message,
    created_at,
    completed_at;
