# Patch brief packs using unified versioning (create new version with caller-supplied content_hash)
# Note: This creates the new version but NOT the group associations.
# You must call insert_brief_pack_groups.sql separately to add groups.
# Display title/description carried as text + *_fluent_message_id reference;
# final SELECT resolves COALESCE(rev.fluent_body(ref), text, name).
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(description_fluent_message_ids)::UUID[],
        :bind(descriptions)::TEXT[],
        :bind(ids)::UUID[],
        :bind(pack_specs)::JSONB[],
        :bind(title_fluent_message_ids)::UUID[],
        :bind(titles)::TEXT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description_fluent_message_id,
        description,
        id,
        pack_spec,
        title_fluent_message_id,
        title,
        ord
    )
),
existing_packs AS (
    SELECT
        vo.path_id,
        args.id as old_id,
        args.title,
        args.description,
        args.title_fluent_message_id,
        args.description_fluent_message_id,
        args.pack_spec,
        args.content_hash,
        args.ord
    FROM args
    JOIN rev.brief_packs bp ON bp.id = args.id
    JOIN rev.versioned_objects vo ON vo.id = bp.versioned_object_id
),
# Create new versioned objects with caller-supplied content_hash
new_versions_inserted AS (
    INSERT INTO rev.versioned_objects (path_id, content_hash)
    SELECT
        ep.path_id,
        ep.content_hash
    FROM existing_packs ep
    ON CONFLICT (path_id, content_hash) DO NOTHING
    RETURNING id, path_id, content_hash, created_at
),
# Include already-existing versioned objects (conflict hit — content reverted)
all_versions AS (
    SELECT nvi.id, nvi.path_id, nvi.content_hash, nvi.created_at
    FROM new_versions_inserted nvi
    UNION ALL
    SELECT vo.id, vo.path_id, vo.content_hash, vo.created_at
    FROM existing_packs ep
    JOIN rev.versioned_objects vo ON vo.path_id = ep.path_id AND vo.content_hash = ep.content_hash
    WHERE NOT EXISTS (
        SELECT 1 FROM new_versions_inserted nvi
        WHERE nvi.path_id = ep.path_id AND nvi.content_hash = ep.content_hash
    )
),
# Create new brief packs (skip if entity row already exists for this versioned_object)
new_packs AS (
    INSERT INTO rev.brief_packs (
        versioned_object_id,
        title,
        description,
        pack_spec,
        title_fluent_message_id,
        description_fluent_message_id
    )
    SELECT
        av.id,
        ep.title,
        ep.description,
        COALESCE(ep.pack_spec, '{}'::jsonb),
        ep.title_fluent_message_id,
        ep.description_fluent_message_id
    FROM existing_packs ep
    JOIN all_versions av ON av.path_id = ep.path_id
    WHERE NOT EXISTS (SELECT 1 FROM rev.brief_packs bp WHERE bp.versioned_object_id = av.id)
    RETURNING
        id,
        versioned_object_id,
        title,
        description,
        pack_spec,
        title_fluent_message_id,
        description_fluent_message_id,
        created_at
),
# Include already-existing brief packs (for reverted versions)
all_packs AS (
    SELECT
        np.id,
        np.versioned_object_id,
        np.title,
        np.description,
        np.title_fluent_message_id,
        np.description_fluent_message_id,
        np.pack_spec,
        np.created_at
    FROM new_packs np
    UNION ALL
    SELECT
        bp.id,
        bp.versioned_object_id,
        bp.title,
        bp.description,
        bp.title_fluent_message_id,
        bp.description_fluent_message_id,
        bp.pack_spec,
        bp.created_at
    FROM rev.brief_packs bp
    JOIN all_versions av ON bp.versioned_object_id = av.id
    WHERE NOT EXISTS (SELECT 1 FROM new_packs np WHERE np.versioned_object_id = av.id)
)
SELECT
    ap.id AS "id!",
    ap.versioned_object_id AS "versioned_object_id!",
    op.id AS "path_id!",
    bppd.name AS "name!",
    av.content_hash AS "content_hash!",
    COALESCE(rev.fluent_body(ap.title_fluent_message_id, 'en'), ap.title, bppd.name) AS "title!",
    COALESCE(rev.fluent_body(ap.description_fluent_message_id, 'en'), ap.description) AS description,
    ap.pack_spec AS "pack_spec!",
    ap.created_at AS "created_at!"
FROM all_packs ap
JOIN all_versions av ON av.id = ap.versioned_object_id
JOIN rev.object_paths op ON op.id = av.path_id
JOIN rev.brief_pack_path_details bppd ON bppd.path_id = op.id
JOIN existing_packs ep ON ep.path_id = av.path_id
# Order is not load-bearing: materialize_brief_system keys these patch results by
# NAME (not position), so `ord` is intentionally not threaded through the all_*
# UNION (the reverted-existing arm has no input ord). Don't switch the caller to
# positional assignment (Class A) without threading ord through both UNION arms.
ORDER BY ap.id;
