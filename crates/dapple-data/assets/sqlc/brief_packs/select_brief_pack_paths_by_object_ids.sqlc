# Select brief pack paths by IDs using unified versioning
# Parameters:
#   $1: ids (UUID[])

WITH args AS (
    SELECT *
    FROM UNNEST($1::UUID[]) WITH ORDINALITY AS o(id, ord)
)
SELECT
    op.id,
    bppd.name,
    op.created_at
FROM args
JOIN rev.object_paths op ON op.id = args.id
JOIN rev.brief_pack_path_details bppd ON bppd.path_id = op.id
ORDER BY op.id;
