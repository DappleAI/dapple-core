# Insert briefs using the unified versioning infrastructure
# Creates: object_path → brief_path_details → versioned_object → brief
# Display title/description: guide-ingest supplies the *_fluent_message_id
# reference (text NULL); direct POST supplies the text (ref NULL). The final
# SELECT resolves COALESCE(rev.fluent_body(ref), text, name).
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(description_fluent_message_ids)::UUID[],
        :bind(descriptions)::TEXT[],
        :bind(names)::TEXT[],
        :bind(title_fluent_message_ids)::UUID[],
        :bind(titles)::TEXT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description_fluent_message_id,
        description,
        name,
        title_fluent_message_id,
        title,
        ord
    )
),
# Get the entity type ID for briefs
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'brief'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (name, namespace_company_id) — see migration 41.
path_details AS (
    INSERT INTO rev.brief_path_details (path_id, name, namespace_company_id)
    SELECT
        np.id,
        args.name,
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, name, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
:compose(shared/insert_versioned_objects.sqlc)
# Create briefs
new_briefs AS (
    INSERT INTO rev.briefs (
        versioned_object_id,
        title,
        description,
        title_fluent_message_id,
        description_fluent_message_id
    )
    SELECT
        nuv.id,
        args.title,
        args.description,
        args.title_fluent_message_id,
        args.description_fluent_message_id
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    ORDER BY args.ord
    RETURNING
        id,
        versioned_object_id,
        title,
        description,
        title_fluent_message_id,
        description_fluent_message_id,
        created_at
),
# Number briefs to preserve ordinality
numbered_briefs AS (
    SELECT nb.*, row_number() OVER (ORDER BY nb.id) AS ord
    FROM new_briefs nb
)
SELECT
    nub.id,
    nub.versioned_object_id,
    nup.id AS path_id,
    npd.name,
    nuv.content_hash,
    COALESCE(rev.fluent_body(nub.title_fluent_message_id, 'en'), nub.title, npd.name) AS "title!",
    COALESCE(rev.fluent_body(nub.description_fluent_message_id, 'en'), nub.description) AS description,
    NULL::UUID AS old_brief_id,
    nub.created_at
FROM numbered_briefs nub
JOIN numbered_versions nuv ON nuv.ord = nub.ord
JOIN numbered_paths nup ON nup.ord = nub.ord
JOIN numbered_path_details npd ON npd.ord = nub.ord
ORDER BY nub.id;
