# Deprecate categories by path IDs
# This creates deprecation events for the latest version of each category path
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(path_ids)::UUID[],
        :bind(reasons)::TEXT[]
    ) WITH ORDINALITY AS o(
        path_id,
        reason,
        ord
    )
),
:compose(shared/deprecate_latest_versions.sqlc)
:compose(shared/deprecate_events.sqlc)
# Return the updated categories
SELECT
    c.id,
    c.versioned_object_id,
    vo.path_id,
    cpd.name,
    cpd.slug,
    vo.content_hash,
    dl.key AS "deprecation_level_key?",
    c.description,
    c.created_at
FROM resolved
JOIN rev.versioned_objects vo ON vo.id = resolved.versioned_object_id
JOIN rev.categories c ON c.versioned_object_id = vo.id
JOIN rev.object_paths op ON op.id = vo.path_id
JOIN rev.category_path_details cpd ON cpd.path_id = op.id
LEFT JOIN rev.deprecation_levels dl ON dl.id = :bind(to_level_id)::SMALLINT
ORDER BY c.id;
