# Insert directives using the unified versioning infrastructure
# Creates: object_path → directive_path_details → versioned_object → directive
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(descriptions)::TEXT[],
        :bind(logics)::JSONB[],
        :bind(max_attempts)::INT[],
        :bind(names)::TEXT[],
        :bind(retry_delay_ms)::INT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description,
        logic,
        max_attempts,
        name,
        retry_delay_ms,
        ord
    )
),
# Get the entity type ID for directives
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'directive'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (name, namespace_company_id) — see migration 41.
path_details AS (
    INSERT INTO rev.directive_path_details (path_id, name, namespace_company_id)
    SELECT
        np.id,
        args.name,
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, name, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
:compose(shared/insert_versioned_objects.sqlc)
# Create directives
new_directives AS (
    INSERT INTO rev.directives (versioned_object_id, logic, max_attempts, retry_delay_ms, description)
    SELECT
        nuv.id,
        args.logic,
        COALESCE(args.max_attempts, 1),
        args.retry_delay_ms,
        args.description
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    ORDER BY args.ord
    RETURNING id, versioned_object_id, logic, max_attempts, retry_delay_ms, description, created_at
),
# Number directives to preserve ordinality
numbered_directives AS (
    SELECT nd.*, row_number() OVER (ORDER BY nd.id) AS ord
    FROM new_directives nd
)
SELECT
    nud.id,
    nud.versioned_object_id,
    nup.id AS path_id,
    npd.name,
    nuv.content_hash,
    nud.logic,
    nud.max_attempts,
    nud.retry_delay_ms,
    nud.description,
    nud.created_at
FROM numbered_directives nud
JOIN numbered_versions nuv ON nuv.ord = nud.ord
JOIN numbered_paths nup ON nup.ord = nud.ord
JOIN numbered_path_details npd ON npd.ord = nud.ord
ORDER BY nud.id;
