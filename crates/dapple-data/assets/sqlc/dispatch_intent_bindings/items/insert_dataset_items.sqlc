# Insert dispatch intent binding dataset items. Each row PINS the current
# rev.asset_dataset_extractions row by hard FK (no envelope copy). Parallel to
# the other typed-item inserts; the caller resolves asset_id -> extraction_id
# before building these args (operator bind handlers + computed-output producer).
# Parameters:
#   $1: binding_ids (UUID[])
#   $2: asset_dataset_extraction_ids (UUID[])

WITH args AS (
    SELECT *
    FROM UNNEST(
        $1::UUID[],
        $2::UUID[]
    ) WITH ORDINALITY AS o(binding_id, asset_dataset_extraction_id, ord)
),
inserted AS (
    INSERT INTO rev.dispatch_intent_binding_dataset_items
        (dispatch_intent_binding_id, asset_dataset_extraction_id)
    SELECT args.binding_id, args.asset_dataset_extraction_id
    FROM args
    ORDER BY args.ord
    RETURNING id, dispatch_intent_binding_id, asset_dataset_extraction_id, created_at
)
SELECT
    i.id,
    i.dispatch_intent_binding_id,
    i.asset_dataset_extraction_id,
    ade.envelope,
    i.created_at
FROM inserted i
JOIN rev.asset_dataset_extractions ade ON ade.id = i.asset_dataset_extraction_id
ORDER BY i.id;
