# Internal fetch of an attempt row by primary key. Used by cache write-through
# and publisher code paths that consume only `.id` / `.dispatch_step_id`; the
# `status` here is derived from the attempt's latest event (the `status` column
# was dropped in Migration 77) and falls back to 'queued' only for the
# never-observed window before the first event. The public-facing
# select_by_object_id / select_by_dispatch_object_id queries additionally
# surface `error_detail`.
SELECT
    a.id,
    a.dispatch_step_id,
    a.task_id,
    COALESCE(
        (
            SELECT ev.phase_code
            FROM rev.dispatch_task_attempt_events ev
            WHERE ev.attempt_id = a.id
            ORDER BY ev.created_at DESC, ev.id DESC
            LIMIT 1
        ),
        'queued'
    ) AS "status!",
    a.context_data,
    a.context_metadata,
    NULL::text AS error_detail,
    a.created_at
FROM rev.dispatch_task_attempts a
WHERE a.id = $1::uuid;
