# Deprecate guides by path IDs.
# Creates deprecation events for the latest version of each guide path.
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(path_ids)::UUID[],
        :bind(reasons)::TEXT[]
    ) WITH ORDINALITY AS o(
        path_id,
        reason,
        ord
    )
),
:compose(shared/deprecate_latest_versions.sqlc)
:compose(shared/deprecate_events.sqlc)
SELECT
    resolved.path_id
FROM resolved
ORDER BY resolved.path_id;
