# Insert guides using the unified versioning infrastructure
# Creates: object_path -> guide_path_details -> versioned_object -> guide
# Fluent-native: no locale column -- guide structure is locale-independent.
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(authors)::TEXT[],
        :bind(classifications)::TEXT[],
        :bind(conduits_mds)::TEXT[],
        :bind(content_hashes)::TEXT[],
        :bind(descriptions)::TEXT[],
        :bind(source_paths)::TEXT[],
        :bind(titles)::TEXT[]
    ) WITH ORDINALITY AS o(
        author,
        classification,
        conduits_md,
        content_hash,
        description,
        source_path,
        title,
        ord
    )
),
# Get the entity type ID for guides
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'guide'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (title, slug, namespace_company_id) — see migration 41.
# guide_path_details uses `title` not `name`; composite UNIQUE keeps it per-namespace.
path_details AS (
    INSERT INTO rev.guide_path_details (path_id, title, slug, namespace_company_id)
    SELECT
        np.id,
        args.title,
        # Slug = the source_path directory basename (directory = slug is the
        # platform rule), e.g. 'public/dapple/learn-from-gaming-vod' ->
        # 'learn-from-gaming-vod'. '^.*/' strips greedily up to the last slash;
        # a slash-less source_path passes through unchanged. Fall back to the
        # title when source_path is null/empty or ends in '/'. slugify still
        # wraps the result so the stored slug stays normalized/idempotent.
        rev.slugify(
            COALESCE(
                NULLIF(regexp_replace(NULLIF(btrim(args.source_path), ''), '^.*/', ''), ''),
                args.title
            )
        ),
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, title, slug, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
# Create versioned objects with content hash (COALESCE for guides)
new_versions AS (
    INSERT INTO rev.versioned_objects (path_id, content_hash)
    SELECT np.id, COALESCE(args.content_hash, '0000000000000000000000000000000000000000')
    FROM numbered_paths np
    JOIN args ON args.ord = np.ord
    ORDER BY np.id
    RETURNING id, path_id, content_hash, created_at
),
# Number versions to preserve ordinality
numbered_versions AS (
    SELECT nv.*, row_number() OVER (ORDER BY nv.id) AS ord
    FROM new_versions nv
),
# Create guides
new_guides AS (
    INSERT INTO rev.guides (id, versioned_object_id, description, author, classification, source_path, conduits_md)
    SELECT
        uuidv7(),
        nuv.id,
        args.description,
        args.author,
        args.classification,
        args.source_path,
        # Conduit-facing guide frame (raw CONDUITS.md markdown), stored per
        # version row so a journey's pinned guide resolves its exact frame.
        args.conduits_md
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    ORDER BY args.ord
    RETURNING id, versioned_object_id, description, author, classification, source_path, created_at
),
# Number guides to preserve ordinality
numbered_guides AS (
    SELECT ng.*, row_number() OVER (ORDER BY ng.id) AS ord
    FROM new_guides ng
)
SELECT
    nug.id,
    nug.versioned_object_id,
    nuv.path_id,
    npd.title,
    npd.slug,
    nuv.content_hash,
    nug.description,
    nug.author,
    nug.classification,
    nug.source_path,
    nug.created_at
FROM numbered_guides nug
JOIN numbered_versions nuv ON nuv.ord = nug.ord
JOIN numbered_paths nup ON nup.ord = nug.ord
JOIN numbered_path_details npd ON npd.ord = nug.ord
ORDER BY nug.id;
