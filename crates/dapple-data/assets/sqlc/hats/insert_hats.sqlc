# Insert hats using the unified versioning infrastructure
# Creates: object_path → hat_path_details → versioned_object → hat
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(descriptions)::TEXT[],
        :bind(names)::TEXT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description,
        name,
        ord
    )
),
# Get the entity type ID for hats
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'hat'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (name, slug, namespace_company_id) — see migration 41.
path_details AS (
    INSERT INTO rev.hat_path_details (path_id, name, slug, namespace_company_id)
    SELECT
        np.id,
        args.name,
        rev.slugify(args.name),
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, name, slug, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
:compose(shared/insert_versioned_objects.sqlc)
# Create hats
new_hats AS (
    INSERT INTO rev.hats (versioned_object_id, description)
    SELECT
        nuv.id,
        args.description
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    ORDER BY args.ord
    RETURNING id, versioned_object_id, description, created_at
),
# Number hats to preserve ordinality
numbered_hats AS (
    SELECT nh.*, row_number() OVER (ORDER BY nh.id) AS ord
    FROM new_hats nh
)
SELECT
    nuh.id,
    nuh.versioned_object_id,
    nuv.path_id,
    npd.name,
    npd.slug,
    nuv.content_hash,
    nuh.description,
    nuh.created_at
FROM numbered_hats nuh
JOIN numbered_versions nuv ON nuv.ord = nuh.ord
JOIN numbered_paths nup ON nup.ord = nuh.ord
JOIN numbered_path_details npd ON npd.ord = nuh.ord
ORDER BY nuh.id;
