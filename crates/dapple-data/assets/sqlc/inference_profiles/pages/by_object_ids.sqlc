args AS (
    SELECT *
    FROM UNNEST(:bind(object_ids)::UUID[]) WITH ORDINALITY AS o(id, ord)
),
inference_profile_page AS (
    SELECT ip.id, args.ord
    FROM args
    JOIN rev.inference_profiles ip ON ip.id = args.id
    ORDER BY args.ord
    LIMIT :bind(limit)::BIGINT OFFSET :bind(offset)::BIGINT
)
