# Record that a (cusip, quarter) slice is cached, so a repeat review skips the
# download and a widened window ingests only the missing quarters. Idempotent:
# re-ingesting a slice refreshes ingested_at rather than erroring.
# Parameters:
#   $1: cusip (TEXT)
#   $2: quarter_end (DATE)
INSERT INTO rev.institutional_holdings_ingest (cusip, quarter_end)
VALUES ($1, $2)
ON CONFLICT (cusip, quarter_end) DO UPDATE SET ingested_at = now();
