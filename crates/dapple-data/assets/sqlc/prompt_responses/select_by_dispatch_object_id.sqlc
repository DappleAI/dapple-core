# Select every prompt response recorded for a dispatch, in execution order.
# prompt_responses.attempt_id -> dispatch_task_attempts.id
#   -> dispatch_step_id -> dispatch_steps -> dispatch_stages -> dispatches.id
SELECT
    pr.id,
    pr.attempt_id,
    pr.prompt_id,
    pr.step_task_id,
    pr.maker_key,
    pr.engine_key,
    pr.engine_version,
    pr.request_messages,
    pr.response_content,
    pr.input_tokens,
    pr.output_tokens,
    pr.latency_ms,
    pr.finish_reason,
    pr.started_at,
    pr.completed_at
FROM rev.prompt_responses pr
WHERE pr.attempt_id IN (
    SELECT a.id
    FROM rev.dispatch_task_attempts a
    WHERE a.dispatch_step_id IN (
        SELECT s.id
        FROM rev.dispatch_steps s
        JOIN rev.dispatch_stages st ON s.dispatch_stage_id = st.id
        JOIN rev.dispatches d ON st.dispatch_id = d.id
        WHERE d.id = :bind(dispatch_id)::UUID
    )
)
ORDER BY pr.started_at ASC, pr.id ASC;
