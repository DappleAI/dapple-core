# External-API prompt page CTE: list prompts scoped to the caller's
# company namespace. Non-deprecated only.
prompt_latest AS (
    SELECT DISTINCT ON (op.id)
        p.id
    FROM rev.prompts p
    JOIN rev.versioned_objects vo ON vo.id = p.versioned_object_id
    JOIN rev.object_paths op ON op.id = vo.path_id
    LEFT JOIN LATERAL (
        :compose(shared/select/latest_deprecation_probe.sqlc)
    ) ld ON TRUE
    LEFT JOIN rev.deprecation_levels dl ON dl.id = ld.to_level_id
    WHERE dl.id IS NULL
      AND op.namespace_company_id = :bind(caller_company_id)::UUID
    ORDER BY op.id, vo.created_at DESC
),
prompt_page AS (
    SELECT id FROM prompt_latest
    ORDER BY id
    LIMIT :bind(limit)::BIGINT OFFSET :bind(offset)::BIGINT
)
