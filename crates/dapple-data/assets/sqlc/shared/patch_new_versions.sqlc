# Try to insert new versioned_objects. If the (path_id, content_hash) already
# exists (content reverted to a prior version), fall back to the existing row.
new_versions_inserted AS (
    INSERT INTO rev.versioned_objects (path_id, content_hash)
    SELECT paths.path_id, args.content_hash
    FROM args
    JOIN paths ON paths.ord = args.ord
    ORDER BY paths.ord
    ON CONFLICT (path_id, content_hash) DO NOTHING
    RETURNING id, path_id, content_hash, created_at
),
new_versions AS (
    # Newly inserted rows — recover the caller's input ord via path_id
    # (1:1 with ord within a patch batch, since each path is patched once).
    SELECT nvi.id, nvi.path_id, nvi.content_hash, nvi.created_at, p.ord
    FROM new_versions_inserted nvi
    JOIN paths p ON p.path_id = nvi.path_id
    UNION ALL
    # Already-existing rows (conflict hit — content reverted to prior version)
    SELECT vo.id, paths.path_id, vo.content_hash, vo.created_at, args.ord
    FROM args
    JOIN paths ON paths.ord = args.ord
    JOIN rev.versioned_objects vo ON vo.path_id = paths.path_id AND vo.content_hash = args.content_hash
    WHERE NOT EXISTS (
        SELECT 1 FROM new_versions_inserted nvi
        WHERE nvi.path_id = paths.path_id AND nvi.content_hash = args.content_hash
    )
),
# Carry the caller's input ord (NOT row_number() over id). In a MIXED batch —
# some rows freshly inserted (new large ids), some returned from the conflict
# arm above (older, smaller ids) — ranking by id would re-order the set and
# mispair version<->entity<->path in every downstream join. Input ord keeps the
# correspondence stable regardless of id values.
numbered_versions AS (
    SELECT nv.id, nv.path_id, nv.content_hash, nv.created_at, nv.ord
    FROM new_versions nv
),
