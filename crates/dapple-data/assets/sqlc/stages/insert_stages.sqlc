# Insert stages using the unified versioning infrastructure
# Creates: object_path → stage_path_details → versioned_object → stage
# Display description: guide-ingest supplies the description_fluent_message_id
# reference (text NULL); direct creation supplies the text (ref NULL). The
# final SELECT resolves COALESCE(rev.fluent_body(ref), text, name).
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(description_fluent_message_ids)::UUID[],
        :bind(descriptions)::TEXT[],
        # One JSON array of authored icon names per stage (open vocabulary,
        # stored verbatim — see migration 98).
        :bind(icons)::JSONB[],
        :bind(kinds)::TEXT[],
        :bind(names)::TEXT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description_fluent_message_id,
        description,
        icons,
        kind,
        name,
        ord
    )
),
# Get the entity type ID for stages
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'stage'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (name, slug, namespace_company_id) — see migration 41.
path_details AS (
    INSERT INTO rev.stage_path_details (path_id, name, slug, namespace_company_id)
    SELECT
        np.id,
        args.name,
        rev.slugify(args.name),
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, name, slug, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
:compose(shared/insert_versioned_objects.sqlc)
# Create stages
new_stages AS (
    INSERT INTO rev.stages (versioned_object_id, description, description_fluent_message_id, kind_id, icons)
    SELECT
        nuv.id,
        args.description,
        args.description_fluent_message_id,
        sk.id,
        # Empty is the same fact as absent, and the hash fold omits empty — so
        # collapse '[]' to NULL here and the row can never disagree with it.
        NULLIF(args.icons, '[]'::JSONB)
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    # LEFT JOIN so an unknown kind key stores NULL and never drops the stage
    # row (insert_brief_outputs display-hint precedent). The materializer
    # validates + warns on the key, so this is defense-in-depth.
    # NOTE: icons has no such join by design — the vocabulary is OPEN and
    # belongs to the drawing client; an unknown name is stored as authored.
    LEFT JOIN rev.stage_kinds sk ON sk.key = args.kind
    ORDER BY args.ord
    RETURNING id, versioned_object_id, description, description_fluent_message_id, kind_id, icons, created_at
),
# Number stages to preserve ordinality
numbered_stages AS (
    SELECT ns.*, row_number() OVER (ORDER BY ns.id) AS ord
    FROM new_stages ns
)
SELECT
    nus.id,
    nus.versioned_object_id,
    nuv.path_id,
    npd.name,
    npd.slug,
    nuv.content_hash,
    COALESCE(rev.fluent_body(nus.description_fluent_message_id, 'en'), nus.description, npd.name) AS "description!",
    sk.key AS "kind?",
    nus.icons AS "icons?",
    nus.created_at
FROM numbered_stages nus
JOIN numbered_versions nuv ON nuv.ord = nus.ord
JOIN numbered_paths nup ON nup.ord = nus.ord
JOIN numbered_path_details npd ON npd.ord = nus.ord
LEFT JOIN rev.stage_kinds sk ON sk.id = nus.kind_id
ORDER BY nus.id;
