# Create new versions of existing stages (PATCH).
# Takes path_id[] to create new versioned objects under existing paths.
# Caller supplies content_hash for idempotent upsert.
# Display description carried as text + description_fluent_message_id reference;
# final SELECT resolves COALESCE(rev.fluent_body(ref), text, name).
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(description_fluent_message_ids)::UUID[],
        :bind(descriptions)::TEXT[],
        # One JSON array of authored icon names per stage (open vocabulary,
        # stored verbatim — see migration 98).
        :bind(icons)::JSONB[],
        :bind(kinds)::TEXT[],
        :bind(path_ids)::UUID[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description_fluent_message_id,
        description,
        icons,
        kind,
        path_id,
        ord
    )
),
paths AS (
    SELECT
        op.id AS path_id,
        spd.name,
        spd.slug,
        args.ord
    FROM args
    JOIN rev.object_paths op ON op.id = args.path_id
    JOIN rev.stage_path_details spd ON spd.path_id = op.id
),
:compose(shared/patch_new_versions.sqlc)
new_stages AS (
    INSERT INTO rev.stages (versioned_object_id, description, description_fluent_message_id, kind_id, icons)
    SELECT
        nuv.id,
        args.description,
        args.description_fluent_message_id,
        sk.id,
        # Empty is the same fact as absent, and the hash fold omits empty — so
        # collapse '[]' to NULL here and the row can never disagree with it.
        NULLIF(args.icons, '[]'::JSONB)
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    # LEFT JOIN so an unknown kind key stores NULL and never drops the stage
    # row (insert_brief_outputs display-hint precedent).
    # NOTE: icons has no such join by design — the vocabulary is OPEN and
    # belongs to the drawing client; an unknown name is stored as authored.
    LEFT JOIN rev.stage_kinds sk ON sk.key = args.kind
    WHERE NOT EXISTS (SELECT 1 FROM rev.stages s WHERE s.versioned_object_id = nuv.id)
    ORDER BY args.ord
    RETURNING id, versioned_object_id, description, description_fluent_message_id, kind_id, icons, created_at
),
all_stages AS (
    # Carry input ord via the version id (nuv.ord is the caller's ord, not an
    # id-rank), so numbered_stages below joins by input order.
    SELECT ns.id, ns.versioned_object_id, ns.description, ns.description_fluent_message_id, ns.kind_id, ns.icons, ns.created_at, nuv.ord
    FROM new_stages ns
    JOIN numbered_versions nuv ON nuv.id = ns.versioned_object_id
    UNION ALL
    # Reused-row arm reports the EXISTING version's stored kind and icons.
    SELECT s.id, s.versioned_object_id, s.description, s.description_fluent_message_id, s.kind_id, s.icons, s.created_at, nuv.ord
    FROM rev.stages s
    JOIN numbered_versions nuv ON s.versioned_object_id = nuv.id
    WHERE NOT EXISTS (SELECT 1 FROM new_stages ns WHERE ns.versioned_object_id = nuv.id)
),
numbered_stages AS (
    SELECT ast.* FROM all_stages ast
)
SELECT
    nus.id AS "id!",
    nus.versioned_object_id AS "versioned_object_id!",
    nuv.path_id AS "path_id!",
    paths.name AS "name!",
    paths.slug AS "slug!",
    nuv.content_hash AS "content_hash!",
    COALESCE(rev.fluent_body(nus.description_fluent_message_id, 'en'), nus.description, paths.name) AS "description!",
    sk.key AS "kind?",
    nus.icons AS "icons?",
    nus.created_at AS "created_at!"
FROM numbered_stages nus
JOIN numbered_versions nuv ON nuv.ord = nus.ord
JOIN paths ON paths.ord = nus.ord
LEFT JOIN rev.stage_kinds sk ON sk.id = nus.kind_id
ORDER BY nus.ord;
