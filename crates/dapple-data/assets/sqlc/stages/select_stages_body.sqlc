# Shared body template for stage SELECT queries.
# Callers provide a @page slot defining one or more CTEs
# that produce a `stage_page` CTE with at minimum `stage_page.id`.
WITH :compose(@page)
SELECT
    st.id,
    st.versioned_object_id,
    vo.path_id,
    spd.name,
    spd.slug,
    vo.content_hash,
    dl.key AS "deprecation_level_key?",
    COALESCE(rev.fluent_body(st.description_fluent_message_id, 'en'), st.description, spd.name) AS "description!",
    sk.key AS "kind?",
    st.icons AS "icons?",
    st.created_at
FROM stage_page stp
JOIN rev.stages st ON st.id = stp.id
JOIN rev.versioned_objects vo ON vo.id = st.versioned_object_id
JOIN rev.object_paths op ON op.id = vo.path_id
JOIN rev.stage_path_details spd ON spd.path_id = op.id
LEFT JOIN rev.stage_kinds sk ON sk.id = st.kind_id
LEFT JOIN LATERAL (
    :compose(shared/select/latest_deprecation_probe.sqlc)
) ld ON TRUE
LEFT JOIN rev.deprecation_levels dl ON dl.id = ld.to_level_id
ORDER BY st.id;
