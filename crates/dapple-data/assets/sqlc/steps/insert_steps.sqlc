# Insert steps using the unified versioning infrastructure
# Creates: object_path → step_path_details → versioned_object → step
# Display description: guide-ingest supplies the description_fluent_message_id
# reference (text NULL); direct creation supplies the text (ref NULL). The
# final SELECT resolves COALESCE(rev.fluent_body(ref), text, name).
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(content_hashes)::TEXT[],
        :bind(description_fluent_message_ids)::UUID[],
        :bind(descriptions)::TEXT[],
        :bind(names)::TEXT[]
    ) WITH ORDINALITY AS o(
        content_hash,
        description_fluent_message_id,
        description,
        name,
        ord
    )
),
# Get the entity type ID for steps
entity_type AS (
    SELECT id FROM rev.entity_types WHERE key = 'step'
),
:compose(shared/insert_object_paths.sqlc)
# Create path details (name, slug, namespace_company_id) — see migration 41.
path_details AS (
    INSERT INTO rev.step_path_details (path_id, name, slug, namespace_company_id)
    SELECT
        np.id,
        args.name,
        rev.slugify(args.name),
        np.namespace_company_id
    FROM args
    JOIN numbered_paths np ON np.ord = args.ord
    RETURNING path_id, name, slug, namespace_company_id
),
:compose(shared/numbered_path_details.sqlc)
:compose(shared/insert_versioned_objects.sqlc)
# Create steps
new_steps AS (
    INSERT INTO rev.steps (versioned_object_id, description, description_fluent_message_id)
    SELECT
        nuv.id,
        args.description,
        args.description_fluent_message_id
    FROM args
    JOIN numbered_versions nuv ON nuv.ord = args.ord
    ORDER BY args.ord
    RETURNING id, versioned_object_id, description, description_fluent_message_id, created_at
),
# Number steps to preserve ordinality
numbered_steps AS (
    SELECT ns.*, row_number() OVER (ORDER BY ns.id) AS ord
    FROM new_steps ns
)
SELECT
    nus.id,
    nus.versioned_object_id,
    nuv.path_id,
    npd.name,
    npd.slug,
    nuv.content_hash,
    COALESCE(rev.fluent_body(nus.description_fluent_message_id, 'en'), nus.description, npd.name) AS "description!",
    nus.created_at
FROM numbered_steps nus
JOIN numbered_versions nuv ON nuv.ord = nus.ord
JOIN numbered_paths nup ON nup.ord = nus.ord
JOIN numbered_path_details npd ON npd.ord = nus.ord
ORDER BY nus.id;
