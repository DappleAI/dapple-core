# True iff `task_id` exists AND its path's `namespace_company_id` matches
# `caller_company_id`. Used by external-API handlers to gate access to a
# single task.
SELECT EXISTS (
    SELECT 1
    FROM rev.tasks t
    JOIN rev.versioned_objects vo ON vo.id = t.versioned_object_id
    JOIN rev.object_paths op ON op.id = vo.path_id
    WHERE t.id = :bind(task_id)::UUID
      AND op.namespace_company_id = :bind(caller_company_id)::UUID
) AS in_namespace;
