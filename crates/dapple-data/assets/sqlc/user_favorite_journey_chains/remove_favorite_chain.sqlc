# Unfavorite the chain that contains :bind(starting_journey_id). Idempotent:
# returns nothing when no active favorite exists for the resolved chain root.
# Append-only via the _removed event table.
#
# Binds (alphabetical → $N):
#   $1 starting_journey_id : any journey in the chain
#   $2 user_object_id      : rev.user_details.object_id (UUID)
WITH RECURSIVE
:compose(shared/journey_chain.sqlc),
chain_root AS (
    SELECT journey_id AS root_id
    FROM journey_chain
    ORDER BY depth DESC
    LIMIT 1
),
user_lookup AS (
    SELECT ud.user_id
    FROM rev.user_details ud
    WHERE ud.object_id = :bind(user_object_id)::UUID
),
active_favorite AS (
    SELECT f.id
    FROM web.user_favorite_journey_chains f
    LEFT JOIN web.user_favorite_journey_chains_removed r
        ON r.user_favorite_journey_chains_id = f.id
    WHERE f.user_id = (SELECT user_id FROM user_lookup)
      AND f.chain_root_journey_id = (SELECT root_id FROM chain_root)
      AND r.user_favorite_journey_chains_id IS NULL
    ORDER BY f.id DESC
    LIMIT 1
)
INSERT INTO web.user_favorite_journey_chains_removed (user_favorite_journey_chains_id, removed_at)
SELECT id, now()
FROM active_favorite
RETURNING user_favorite_journey_chains_id, removed_at;
