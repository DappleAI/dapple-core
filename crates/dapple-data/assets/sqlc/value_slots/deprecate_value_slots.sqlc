# Deprecate value slots by path IDs
# This creates deprecation events for the latest version of each value slot path
WITH args AS (
    SELECT *
    FROM UNNEST(
        :bind(path_ids)::UUID[],
        :bind(reasons)::TEXT[]
    ) WITH ORDINALITY AS o(
        path_id,
        reason,
        ord
    )
),
:compose(shared/deprecate_latest_versions.sqlc)
:compose(shared/deprecate_events.sqlc)
# Return the updated value slots
SELECT
    vs.id,
    vs.versioned_object_id,
    op.id AS path_id,
    vspd.name,
    vk.key as value_kind_key,
    vo.content_hash,
    dl.key AS "deprecation_level_key?",
    vs.title,
    vs.description,
    vs.constraints,
    vs.cardinality,
    vs.min_selections,
    vs.max_selections,
    vs.created_at
FROM resolved
JOIN rev.versioned_objects vo ON vo.id = resolved.versioned_object_id
JOIN rev.value_slots vs ON vs.versioned_object_id = vo.id
JOIN rev.object_paths op ON op.id = vo.path_id
JOIN rev.value_slot_path_details vspd ON vspd.path_id = op.id
JOIN rev.value_kinds vk ON vk.id = vs.value_kind_id
LEFT JOIN rev.deprecation_levels dl ON dl.id = :bind(to_level_id)::SMALLINT
ORDER BY vs.id;
