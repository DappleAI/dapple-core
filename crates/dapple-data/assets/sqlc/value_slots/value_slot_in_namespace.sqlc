# True iff `value_slot_id` exists AND its path lives in `caller_company_id`'s
# namespace. Used by external-API handlers to gate `GET /api/value-slots/{id}`.
SELECT EXISTS (
    SELECT 1
    FROM rev.value_slots vs
    JOIN rev.versioned_objects vo ON vo.id = vs.versioned_object_id
    JOIN rev.object_paths op ON op.id = vo.path_id
    WHERE vs.id = :bind(value_slot_id)::UUID
      AND op.namespace_company_id = :bind(caller_company_id)::UUID
) AS in_namespace;
