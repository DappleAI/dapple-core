{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dapple:schema:provenance:1",
  "title": "Dapple document provenance manifest",
  "description": "Where each part of one rendered document came from: the document's identity, the sources it declared, every tagged item (full text, and for a figure its value as filed), and how much of the text each origin accounts for. Produced by `document render` beside the PDF and HTML.",
  "type": "object",
  "required": ["$schema", "version", "document", "sources", "items", "coverage", "warnings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "urn:dapple:schema:provenance:1" },
    "version": { "const": 1 },
    "document": { "$ref": "#/$defs/document" },
    "default_source": {
      "description": "Source id that untagged text is attributed to.",
      "$ref": "#/$defs/id"
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": {
      "description": "Tagging mistakes. Never fatal: the render succeeded and these were skipped.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "urn": {
      "type": "string",
      "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:.+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
      "description": "filing: a public record someone else filed. generated: a model wrote it. operator: the person running the journey supplied it. computed: derived from other sources. authored: the guide's own template text. unknown: an undeclared source or unrecognized kind.",
      "enum": ["filing", "generated", "operator", "computed", "authored", "unknown"]
    },
    "document": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "urn:dapple:document:<uuid>, minted once per render.",
          "$ref": "#/$defs/urn"
        },
        "title": { "type": "string" },
        "rendered_at": { "type": "string", "format": "date-time" },
        "derived_from": {
          "description": "The document this one is a corrected or improved version of.",
          "$ref": "#/$defs/urn"
        },
        "dispatch_id": { "$ref": "#/$defs/uuid" },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pdf": { "$ref": "#/$defs/uuid" },
            "html": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "detail", "chars", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/kind" },
        "label": { "type": "string" },
        "detail": {
          "description": "Every registry field other than kind and label, verbatim (publisher, form, accession, filed, url, model, prompt, from, ...).",
          "type": "object"
        },
        "chars": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "quantity": {
      "description": "A value as filed, exactly.",
      "type": "object",
      "required": ["amount", "unit"],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Exact decimal string, never a JSON number.",
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "description": "XBRL unit id: USD, shares, USD/shares, pure, ...",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/-]+$"
        },
        "decimals": {
          "description": "XBRL precision: decimal places the value is accurate to, or INF for exact.",
          "oneOf": [{ "type": "integer" }, { "const": "INF" }]
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "form", "source", "kind", "text", "markdown", "chars"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique within the manifest: author-given, or <anchor>/<source>/<n>.",
          "type": "string",
          "minLength": 1
        },
        "form": { "enum": ["inline", "passage", "figure"] },
        "source": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "kind": { "oneOf": [{ "$ref": "#/$defs/kind" }, { "type": "null" }] },
        "section": {
          "type": "object",
          "required": ["title", "anchor"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "anchor": { "type": "string" }
          }
        },
        "text": { "description": "Full plain text as the reader saw it.", "type": "string" },
        "markdown": { "description": "The item's exact source markdown.", "type": "string" },
        "chars": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/quantity" },
        "period": {
          "type": "object",
          "required": ["end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/date" },
            "end": { "$ref": "#/$defs/date" }
          }
        },
        "concept": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]+$" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["total_chars", "attributed_chars", "unattributed_chars", "by_kind"],
      "additionalProperties": false,
      "properties": {
        "total_chars": { "type": "integer", "minimum": 0 },
        "attributed_chars": { "type": "integer", "minimum": 0 },
        "unattributed_chars": { "type": "integer", "minimum": 0 },
        "by_kind": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/kind" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
